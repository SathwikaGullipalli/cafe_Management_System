menu={'Pizza':100, 'Salad':30,'Burger':200,'Chocolate':20,'Coffee':50,'Iced Americano':150}
print('Welcome to Engineers Cafe')
print('Here is our Menu')

print('Pizza:100\nSalad:30\nBurger:200\nChocolate:20\nCoffee:50\nIced Americano:150\n')
order_item=input('Enter the item:').title()

order_total=0

if order_item in menu:
    order_total+=menu[order_item]
    order=input('Do you want anything else(Yes/No):')
    if order=='Yes':
        order_item2=input('Enter your another item:').title()
        if order_item2 in menu:
            order_total+= menu[order_item2]
            print(f'Your Order value:{order_total}')
    else:
        print(f'Your Order value:{order_total}')
else:
    print('You entered the item which is not in the Menu')
print('Thank You!!')  
